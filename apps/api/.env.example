# ─── Servidor ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── MongoDB Atlas ──────────────────────────────────────────────────
# Crear cluster en https://www.mongodb.com/cloud/atlas
# Whitelist IP del servidor (o 0.0.0.0/0 para Railway/Render)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/

# ─── Auth (JWT) ─────────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
# IMPORTANTE: rotar antes de pasar a prod. Mínimo 32 chars.
JWT_SECRET=change-me-32-chars-minimum-please-rotate
JWT_REFRESH_SECRET=change-me-32-chars-minimum-please-rotate-refresh

# ─── URLs (frontend + back) ─────────────────────────────────────────
APP_URL_FRONT=https://soyalantapia.github.io/misanpedro
APP_URL_API=http://localhost:3001

# CORS allowlist adicional (coma-separada). APP_URL_FRONT siempre se incluye.
# En dev, localhost:5180/5173/127.0.0.1 también se incluyen automáticamente.
# Ejemplo prod: https://app.misanpedro.com,https://staging.misanpedro.com
CORS_ORIGINS=

# Confiar en headers X-Forwarded-* del proxy (Railway/Render: true).
# Activa HTTPS redirect, request IP real para rate-limit.
# Local sin proxy: false.
TRUST_PROXY=false

# ─── Mercado Pago (suscripciones) ───────────────────────────────────
# Obtener desde https://www.mercadopago.com.ar/developers/panel/credentials
# Si MP_ACCESS_TOKEN está vacío, el endpoint /billing/preapproval funciona
# en modo MOCK (devuelve un init_point falso para testing local).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Crear "Webhook Secret" desde el panel de notifications de MP.
# Si está vacío, el webhook acepta todos los POSTs (ÚNICAMENTE para dev).
# CRÍTICO en prod: setearlo. El handler valida firma HMAC SHA256.
MP_WEBHOOK_SECRET=

# ─── Email (OTP, opcional Fase 1) ───────────────────────────────────
# Resend.com — https://resend.com/api-keys
# Si está vacío, el OTP se loguea a consola y se devuelve `_debugCode`
# en la response (sólo cuando NODE_ENV !== 'production').
RESEND_API_KEY=
EMAIL_FROM=Mi San Pedro <onboarding@resend.dev>

# ─── Observabilidad ─────────────────────────────────────────────────
# Sentry — captura uncaughtException, unhandledRejection y errores HTTP 500.
# Si está vacío, los wrappers son no-op.
# Para activar:
#   pnpm --filter @misanpedro/api add @sentry/node
SENTRY_DSN=

# ─── WhatsApp Web (whatsapp-web.js + Puppeteer) ─────────────────────
# Path donde se persisten las sesiones LocalAuth (cookies + tokens MD).
# Si la carpeta no existe se crea al iniciar la primera sesión.
# La dependencia `whatsapp-web.js` es OPCIONAL — si no está instalada,
# el servicio corre en modo stub (no envía mensajes pero loguea).
# Para activar:
#   pnpm --filter @misanpedro/api add whatsapp-web.js qrcode-terminal
WHATSAPP_SESSIONS_DIR=/tmp/wa-sessions
