# ─── Servidor ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── MongoDB ────────────────────────────────────────────────────────
# Opciones:
#  · MongoDB Atlas (cloud): https://www.mongodb.com/cloud/atlas
#  · Railway MongoDB plugin (recomendado si todo vive en Railway)
#  · MongoDB local: mongodb://localhost:27017/cuponcito-dev
# Si usás Atlas: whitelist IP 0.0.0.0/0 (Railway/Render no tienen IP fija).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/cuponcito

# ─── Auth (JWT) ─────────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
# IMPORTANTE: rotar antes de pasar a prod. Mínimo 32 chars cada uno.
JWT_SECRET=change-me-32-chars-minimum-please-rotate
JWT_REFRESH_SECRET=change-me-32-chars-minimum-please-rotate-refresh

# ─── URLs (frontend + back) ─────────────────────────────────────────
# En Railway, APP_URL_API es la URL del propio service:
#   https://cuponcito-api-production.up.railway.app
# o tu dominio custom si configuraste uno.
APP_URL_FRONT=https://soyalantapia.github.io/misanpedro
APP_URL_API=http://localhost:3001

# CORS allowlist adicional (coma-separada). APP_URL_FRONT siempre se incluye.
# En dev, localhost:5180/5173/5181/127.0.0.1 también se incluyen automáticamente.
# Ejemplo prod con multi-tenant:
#   https://sanpedro.cuponcito.app,https://ramallo.cuponcito.app,https://admin.cuponcito.app
CORS_ORIGINS=

# Confiar en headers X-Forwarded-* del proxy (Railway/Render: true).
# Activa HTTPS redirect, request IP real para rate-limit.
# Local sin proxy: false.
TRUST_PROXY=false

# ─── Plan / pricing ─────────────────────────────────────────────────
# Precio mensual en ARS que ven los comercios. Default $25.000.
# Es el precio FINAL (no se suma IVA arriba). El IVA se maneja en factura.
PLAN_AMOUNT_ARS=25000

# ─── Soporte ────────────────────────────────────────────────────────
# Email y WhatsApp visibles en TyC + panel ayuda.
SUPPORT_EMAIL=hola@misanpedro.app
SUPPORT_WHATSAPP=+5493329000000

# ─── Super-admin / Owner ────────────────────────────────────────────
# Token temporal del owner panel actual (legacy). En Fase 1 lo
# reemplazamos con auth real (email + password + 2FA TOTP).
# Generar con: openssl rand -base64 48
# Si está vacío o tiene <16 chars, los endpoints /api/v1/admin/* devuelven 503.
SUPER_ADMIN_TOKEN=

# ─── Mercado Pago (suscripciones) ───────────────────────────────────
# Obtener desde https://www.mercadopago.com.ar/developers/panel/credentials
# Si MP_ACCESS_TOKEN está vacío, /billing/preapproval funciona en modo MOCK
# (devuelve init_point falso para testing local).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Crear "Webhook Secret" desde el panel de notifications de MP.
# Si está vacío, el webhook acepta todos los POSTs (sólo dev).
# CRÍTICO en prod: setearlo. El handler valida firma HMAC SHA256.
MP_WEBHOOK_SECRET=

# ─── Email (Resend, opcional) ──────────────────────────────────────
# https://resend.com/api-keys
# Si está vacío, el OTP se loguea a consola y se devuelve _debugCode
# en la response (sólo cuando NODE_ENV !== 'production').
RESEND_API_KEY=
EMAIL_FROM=Cuponcito <onboarding@resend.dev>

# ─── Observabilidad (Sentry, opcional) ──────────────────────────────
# Sentry captura uncaughtException, unhandledRejection y errores HTTP 500.
# Si está vacío, los wrappers son no-op.
# Para activar:
#   pnpm --filter @misanpedro/api add @sentry/node
SENTRY_DSN=

# ─── WhatsApp Web (whatsapp-web.js + Puppeteer) ─────────────────────
# Path donde se persisten las sesiones LocalAuth.
# En Railway usar /tmp/ (efímero — se pierde al redeploy). Para persistir
# entre deploys, montar un volume y apuntar acá.
# Para que NO se descargue Chromium en el build (acelera deploy):
#   set PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
WHATSAPP_SESSIONS_DIR=/tmp/wa-sessions
