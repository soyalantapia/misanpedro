{
  "name": "@misanpedro/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --import tsx --env-file=.env src/index.ts",
    "build": "tsc -b --noEmit && node build.mjs",
    "start": "node dist/index.js",
    "start:local": "node --env-file=.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@misanpedro/shared": "workspace:*",
    "@sentry/node": "^10.55.0",
    "bcryptjs": "^3.0.2",
    "hono": "^4.10.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.0",
    "nodemailer": "^9.0.1",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.0",
    "mongodb-memory-server": "^11.2.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.7"
  }
}
